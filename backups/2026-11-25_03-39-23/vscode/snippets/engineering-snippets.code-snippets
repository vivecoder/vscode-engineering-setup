	"SQL Duplicate Validation": {
		"scope": "sql",
		"prefix": "sqldup",
		"body": [
			"SELECT",
			"    ${1:key_column},",
			"    COUNT(*) AS duplicate_count",
			"FROM ${2:table_name}",
			"GROUP BY ${1:key_column}",
			"HAVING COUNT(*) > 1;",
			"$0"
		],
		"description": "Identify duplicate records"
	},
	"SQL Null Validation": {
		"scope": "sql",
		"prefix": "sqlnull",
		"body": [
			"SELECT COUNT(*) AS null_count",
			"FROM ${1:table_name}",
			"WHERE ${2:column_name} IS NULL;",
			"$0"
		],
		"description": "Validate null values"
	},
